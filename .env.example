# Copy to .env and fill in

# OPNsense web UI address
OPNSENSE_URL=https://opnsense.example.com:4443

# API key (System -> Access -> Users -> pick a user -> API keys -> +)
OPNSENSE_KEY=
OPNSENSE_SECRET=

# Interfaces to watch, comma separated (API names: lan, opt1, ...)
IFACES=lan

# Verify the TLS certificate (0 for a self-signed one)
TLS_VERIFY=1

# Poll interval, seconds
POLL_SECONDS=2

# Poll interval for connections, rules and WireGuard, seconds
STATES_SECONDS=10

# Refresh interval for host names (ARP/DHCP/reverse DNS), seconds
ENRICH_SECONDS=60

# If "download" and "upload" look swapped — set this to 1
DIRECTION_SWAP=0

# Where the Statedash web UI listens. This machine only by default.
# To expose it on the LAN: LISTEN=0.0.0.0:8080 (set a password first!)
LISTEN=127.0.0.1:8080

# Who the container runs as. Defaults to uid 1000, the owner of ./data and .env
# on most systems. If yours differs, set these to `id -u` and `id -g` —
# otherwise settings changed in the web interface cannot be saved to disk.
PUID=1000
PGID=1000

# Demo mode without OPNsense (to try out the UI)
# Where the long-term history is kept; empty means beside the settings file.
# With nowhere writable the store switches itself off and only the live view
# remains — that is not an error.
HISTORY_PATH=

MOCK=0
# How many hosts the generator invents; 0 keeps the small fixed set
MOCK_HOSTS=0

# Public demonstration: everything is visible, nothing can be changed. Turn this
# on before putting an instance somewhere anyone can reach it.
DEMO=0
