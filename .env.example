# Copy to .env and fill in

# OPNsense web UI address
OPNSENSE_URL=https://opnsense.example.com:4443

# API key (System -> Access -> Users -> pick a user -> API keys -> +)
OPNSENSE_KEY=
OPNSENSE_SECRET=

# Interfaces to watch, comma separated (API names: lan, opt1, ...)
IFACES=lan

# Verify the TLS certificate (0 for a self-signed one)
TLS_VERIFY=1

# Poll interval, seconds
POLL_SECONDS=2

# Poll interval for connections, rules and WireGuard, seconds
STATES_SECONDS=10

# Refresh interval for host names (ARP/DHCP/reverse DNS), seconds
ENRICH_SECONDS=60

# If "download" and "upload" look swapped — set this to 1
DIRECTION_SWAP=0

# Where the Statedash web UI listens. This machine only by default.
# To expose it on the LAN: LISTEN=0.0.0.0:8080 (set a password first!)
LISTEN=127.0.0.1:8080

# Demo mode without OPNsense (to try out the UI)
MOCK=0
